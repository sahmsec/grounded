# ---------------------------------------------------------------------------
# grounded — Phase 1 configuration
# Copy to .env and fill in. Only GEMINI_API_KEYS is required for a live run.
# ---------------------------------------------------------------------------

# --- database --------------------------------------------------------------
DATABASE_URL=postgres://grounded:grounded@localhost:5433/grounded

# --- credentials -----------------------------------------------------------
# Comma-separate as many keys per provider as you have. Each one becomes an
# independent rotation slot with its own quota counters.
#   GEMINI_API_KEYS=AIza...one,AIza...two,AIza...three
GEMINI_API_KEYS=
OPENAI_API_KEYS=

# --- pool composition ------------------------------------------------------
# Ordered provider list. Every key of the first provider is tried before the
# second provider is touched, so free tiers drain before paid ones.
LLM_POOL=gemini
# Embedding pools may rotate across KEYS but never across MODELS. Listing two
# different embedding providers here is rejected at startup on purpose.
EMBEDDING_POOL=gemini

# --- models ----------------------------------------------------------------
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# --- per-credential quota limits ------------------------------------------
# These are what the pool counts against locally to skip a spent key without
# spending a request to find out. Set them to your plan's actual limits.
GEMINI_RPM=10
GEMINI_RPD=250
GEMINI_TPM=250000
OPENAI_RPM=60
OPENAI_RPD=10000
OPENAI_TPM=150000

# Fraction of the daily cap that triggers a quota.approaching warning.
QUOTA_WARN_RATIO=0.8
# Cooldown applied when a provider returns 429 without a Retry-After header.
DEFAULT_COOLDOWN_MS=60000

# --- relevance gate --------------------------------------------------------
# Below MIN_TOP_SIMILARITY the model is never called.
MIN_TOP_SIMILARITY=0.62
MIN_CHUNK_SIMILARITY=0.55
MAX_CONTEXT_CHUNKS=5
CANDIDATE_LIMIT=20

# --- chunking --------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- generation ------------------------------------------------------------
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.2

# --- runtime ---------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
