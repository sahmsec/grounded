{
  "name": "grounded",
  "version": "0.1.0",
  "description": "Grounded cybersecurity assistant — retrieval-augmented, refuses when unsupported",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "migrate": "node scripts/migrate.ts",
    "seed": "node scripts/seed.ts",
    "ask": "node scripts/ask.ts",
    "verify": "node scripts/verify.ts",
    "start": "node src/server/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
